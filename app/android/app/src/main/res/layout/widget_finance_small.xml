<?xml version="1.0" encoding="utf-8"?>
<!-- 2x2：按参考图 1:1 复刻 —— 内容顶部对齐、四边 14dp、右下小圆加号 -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <!-- 顶部大数字（左右撑满） -->
    <TextView
        android:id="@+id/widget_consumable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="18sp"
        android:autoSizeMaxTextSize="44sp"
        android:autoSizeStepGranularity="1sp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="¥ --"
        android:textColor="@color/widget_value"
        android:textSize="30sp"
        android:textStyle="bold" />

    <!-- 标签 + 眼睛 + 范围（紧贴数字下方） -->
    <LinearLayout
        android:id="@+id/widget_label_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_consumable"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="剩余可消费"
            android:textColor="@color/widget_label"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/widget_eye"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="7dp"
            android:contentDescription="隐藏金额"
            android:src="@drawable/widget_eye" />

        <TextView
            android:id="@+id/widget_scope"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:text="· 家庭"
            android:textColor="@color/widget_accent"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 第二块：紧接标签行下方（顶对齐流式排布，同参考图） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_label_row"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="52dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="当月已消费"
            android:textColor="@color/widget_label"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widget_spent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="¥ --"
            android:textColor="@color/widget_spent_value"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 右下角小圆加号（参考图约 40dp，非大按钮） -->
    <TextView
        android:id="@+id/widget_add"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:background="@drawable/widget_add_btn"
        android:gravity="center"
        android:text="+"
        android:textColor="@color/widget_add_fg"
        android:textSize="25sp" />
</RelativeLayout>
