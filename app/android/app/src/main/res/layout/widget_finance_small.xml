<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面小卡片（2x2）：精确复刻参考图布局 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical">

        <!-- 大数字 -->
        <TextView
            android:id="@+id/widget_consumable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:text="¥ --"
            android:textColor="@color/widget_value"
            android:textSize="29sp"
            android:textStyle="bold" />

        <!-- 标签 + 眼睛 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="剩余可消费"
                android:textColor="@color/widget_label"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/widget_eye"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="7dp"
                android:contentDescription="隐藏金额"
                android:src="@drawable/widget_eye" />
        </LinearLayout>

        <!-- 第二块：标题 + 数值 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="当月已消费"
                android:textColor="@color/widget_label"
                android:textSize="13sp" />

            <!-- 范围（点击切换家庭/个人） -->
            <TextView
                android:id="@+id/widget_scope"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="· 家庭"
                android:textColor="@color/widget_accent"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_spent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:text="¥ --"
            android:textColor="@color/widget_spent_value"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 右下角大圆加号 -->
    <TextView
        android:id="@+id/widget_add"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:background="@drawable/widget_add_btn"
        android:gravity="center"
        android:text="+"
        android:textColor="@color/widget_add_fg"
        android:textSize="31sp" />
</FrameLayout>
