<?xml version="1.0" encoding="utf-8"?>
<!-- 4x2：顶块贴顶、第二块贴底、加号贴右下，四边留白一致（18dp） -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="18dp">

    <TextView
        android:id="@+id/widget_consumable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="20sp"
        android:autoSizeMaxTextSize="52sp"
        android:autoSizeStepGranularity="1sp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="¥ --"
        android:textColor="@color/widget_value"
        android:textSize="36sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/widget_label_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_consumable"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="剩余可消费"
            android:textColor="@color/widget_label"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/widget_eye"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="7dp"
            android:contentDescription="隐藏金额"
            android:src="@drawable/widget_eye" />

        <TextView
            android:id="@+id/widget_scope"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="· 家庭"
            android:textColor="@color/widget_accent"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_toStartOf="@id/widget_add"
        android:layout_marginEnd="10dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="当月已消费"
            android:textColor="@color/widget_label"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/widget_spent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="¥ --"
            android:textColor="@color/widget_spent_value"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_add"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:background="@drawable/widget_add_btn"
        android:gravity="center"
        android:text="+"
        android:textColor="@color/widget_add_fg"
        android:textSize="32sp" />
</RelativeLayout>
