<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面小卡片（4x2）：与 2x2 同风格，更宽更大 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_consumable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="20sp"
            android:autoSizeMaxTextSize="52sp"
            android:autoSizeStepGranularity="1sp"
            android:includeFontPadding="false"
            android:text="¥ --"
            android:textColor="@color/widget_value"
            android:textSize="36sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="剩余可消费"
                android:textColor="@color/widget_label"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/widget_eye"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="7dp"
                android:contentDescription="隐藏金额"
                android:src="@drawable/widget_eye" />

            <TextView
                android:id="@+id/widget_scope"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="· 家庭"
                android:textColor="@color/widget_accent"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="当月已消费"
                android:textColor="@color/widget_label"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_spent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:text="¥ --"
            android:textColor="@color/widget_spent_value"
            android:textSize="21sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_add"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="bottom|end"
        android:background="@drawable/widget_add_btn"
        android:gravity="center"
        android:text="+"
        android:textColor="@color/widget_add_fg"
        android:textSize="33sp" />
</FrameLayout>
