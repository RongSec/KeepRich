# ===== 后端 =====
APP_ENV=production
APP_PORT=8080
APP_NAME=family-finance

# 数据库
DB_HOST=mysql
DB_PORT=3306
DB_USER=finance
DB_PASSWORD=finance_pass
DB_NAME=family_finance
DB_CHARSET=utf8mb4
DB_PARSE_TIME=true
DB_LOC=Local

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=2592000

# 多因子认证
MFA_ISSUER=FamilyFinance
MFA_COOLDOWN_DAYS=7

# 通知
NOTIFY_WS_ENABLED=true
NOTIFY_FCM_ENABLED=false
FCM_SERVER_KEY=

# 业务默认值
PLAN_SERIOUS_ILLNESS_TARGET=1000000
PLAN_EMERGENCY_MONTHS=6
PLAN_BIG_PURCHASE_RATIO=0.5
PLAN_INVEST_ANNUAL_RATE=0.05
