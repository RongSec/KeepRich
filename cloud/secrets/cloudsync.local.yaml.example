# 云端快照 sidecar 模板（**只有占位符，可入库**）
#
# 用法：
#   cp cloud/secrets/cloudsync.local.yaml.example cloud/secrets/cloudsync.local.yaml
#   然后把 apiKey 换成云应用控制台里的 publishableKey
#
# 为什么是 sidecar 文件而不是写进 backend/config/config.yaml：
#   ① 仓库是公开的，真实 key 入库即泄漏（该表 RLS 对 anon 放行，key 泄漏 = 全量数据 + 口令哈希泄漏）；
#   ② cloud/secrets/ 已被 .gitignore 忽略；
#   ③ cloud/sync.sh 会在 cp -R config 之后把它注入到部署目录的 config/ 下，
#      并在 SYNC_OK 之前硬校验"不能还是这个占位符"。
#
# 优先级：环境变量 CLOUD_SYNC_* > config/cloudsync.local.yaml > config/config.yaml

cloudSync:
  enabled: true
  endpoint: "https://keeprich-finance.app.workbuddy.host/.cloud/database/rest/finance_snapshot"
  apiKey: "<publishableKey，从云应用控制台复制>"
  # 云端快照行主键，默认 1。测试想用独立行（如 999）时改这里，不动线上那行。
  snapshotId: 1
  debounceMs: 1500
  pushTimeoutSec: 5
  # 只增日志表不进快照：否则 payload 每次写操作都单调膨胀，且对"账目完整"零贡献
  excludeTables: ["audit_logs", "error_reports"]
